---
import SectionHeading from "../components/SectionHeading.astro";
import { builtFor } from "../data/product";
---

<section
  id="built-for"
  class="cut-top relative -mt-[3.5vw] overflow-hidden bg-ink-950 pb-20 pt-[calc(3.5vw+5rem)] lg:pb-28"
>
  <div class="shell">
    <SectionHeading
      eyebrow="Built for"
      heading="If it has glass and sees dirt"
      body="It started as a UTV tool. It didn't stay one."
      align="center"
    />

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        builtFor.map((item, i) => (
          <li
            class="reveal group relative flex items-center gap-4 overflow-hidden border-l-2 border-ink-700 bg-ink-900 py-5 pl-6 pr-5 transition-all duration-300 hover:border-brand-500 hover:bg-ink-850"
            style={`transition-delay: ${i * 50}ms`}
          >
            <div class="min-w-0">
              <p class="font-display text-xl uppercase text-white">{item.name}</p>
              <p class="mt-0.5 truncate text-sm text-steel-500">{item.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
