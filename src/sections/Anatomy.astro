---
import SectionHeading from "../components/SectionHeading.astro";
import ImageSlot from "../components/ImageSlot.astro";
import { anatomy } from "../data/product";
---

<section id="anatomy" class="relative overflow-hidden bg-ink-900 py-20 lg:py-28">
  <div class="shell">
    <SectionHeading
      eyebrow={anatomy.eyebrow}
      heading={anatomy.heading}
      body={anatomy.body}
      align="center"
    />

    <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16">
      <!-- Annotated product image. Callout dots are absolutely positioned
           by percentage so they can be nudged once the real cutout lands. -->
      <div class="reveal relative mx-auto w-full max-w-md">
        <div
          class="absolute inset-0 -z-10 rounded-full bg-brand-600/20 blur-[80px]"
          aria-hidden="true"
        >
        </div>

        <ImageSlot
          ratio="3 / 4"
          alt="Squeejit bottle with its scrubber and squeegee visible"
          note="PRODUCT CUTOUT — the bottle on a clean transparent or seamless background, lit from both sides, scrubber and squeegee edge clearly visible. This one needs to be sharp."
        />

        {
          anatomy.parts.map((part, i) => (
            <span
              class="pointer-events-none absolute hidden lg:block"
              style={`left: ${part.x}%; top: ${part.y}%; transform: translate(-50%, -50%)`}
              aria-hidden="true"
            >
              <span class="relative flex h-7 w-7">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-60" />
                <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-full border-2 border-brand-400 bg-ink-950 font-display text-sm font-bold text-brand-300">
                  {i + 1}
                </span>
              </span>
            </span>
          ))
        }
      </div>

      <!-- Callout list. On mobile this is the whole story; the numbered dots
           above are a large-screen enhancement. -->
      <ul class="flex flex-col gap-5">
        {
          anatomy.parts.map((part, i) => (
            <li
              class="reveal flex gap-5 border border-ink-700 bg-ink-850 p-6"
              style={`transition-delay: ${i * 80}ms`}
            >
              <span class="grid h-9 w-9 shrink-0 place-items-center border border-brand-600 bg-brand-600/15 font-display text-lg font-bold text-brand-300">
                {i + 1}
              </span>

              <div>
                <h3 class="text-xl text-white">{part.label}</h3>
                <p class="mt-1.5 leading-relaxed text-steel-400">{part.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
