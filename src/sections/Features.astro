---
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import { features } from "../data/product";
---

<section id="features" class="relative overflow-hidden bg-ink-950 py-20 lg:py-28">
  <div class="texture-topo absolute inset-0 opacity-50"></div>

  <div class="shell relative">
    <SectionHeading
      eyebrow="Why it earns its spot"
      heading="Small enough to forget. There when you need it."
      align="center"
    />

    <ul class="mt-16 grid gap-px overflow-hidden border border-ink-700 bg-ink-700 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature, i) => (
          <li
            class="reveal group relative bg-ink-900 p-8 transition-colors duration-300 hover:bg-ink-850"
            style={`transition-delay: ${i * 60}ms`}
          >
            <span class="inline-grid h-12 w-12 place-items-center border border-brand-600/50 bg-brand-600/10 text-brand-400 transition-colors duration-300 group-hover:border-brand-500 group-hover:text-brand-300">
              <Icon name={feature.icon} class="h-6 w-6" />
            </span>

            <h3 class="mt-5 text-2xl text-white">{feature.title}</h3>
            <p class="mt-2.5 leading-relaxed text-steel-400">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
