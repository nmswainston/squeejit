---
import ImageSlot from "../components/ImageSlot.astro";
import { problem } from "../data/product";
---

<section id="problem" class="relative overflow-hidden bg-ink-900 py-20 lg:py-28">
  <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="reveal order-2 lg:order-1">
      <ImageSlot
        ratio="3 / 2"
        alt="A UTV windshield completely coated in dried mud"
        note="PROBLEM SHOT. Windshield so caked you can barely see the trail through it. Shot from the driver's seat looking out. This is the 'before' the whole page hangs on."
      />
    </div>

    <div class="reveal order-1 lg:order-2">
      <p class="eyebrow">{problem.eyebrow}</p>

      <h2 class="mt-4 text-4xl sm:text-5xl lg:text-6xl">{problem.heading}</h2>

      <p class="mt-6 text-lg leading-relaxed text-steel-400">{problem.body}</p>

      <blockquote
        class="mt-8 border-l-4 border-hazard-500 bg-ink-850 py-4 pl-5 pr-4 font-display text-xl uppercase leading-tight text-steel-200 sm:text-2xl"
      >
        {problem.kicker}
      </blockquote>
    </div>
  </div>
</section>
