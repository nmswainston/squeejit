---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import CtaButton from "./CtaButton.astro";
import { nav } from "../data/product";
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
  data-scrolled="false"
>
  <div
    class="border-b border-transparent transition-all duration-300 [[data-scrolled=true]_&]:border-ink-700 [[data-scrolled=true]_&]:bg-ink-950/90 [[data-scrolled=true]_&]:backdrop-blur-md"
  >
    <div class="shell flex h-20 items-center justify-between gap-6">
      <a href="#top" class="shrink-0" aria-label={`${"Squeejit"} home`}>
        <Logo />
      </a>

      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-8">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-display text-sm font-semibold uppercase tracking-[0.16em] text-steel-300 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <div class="hidden sm:block">
          <CtaButton href="#buy" size="md">Buy now</CtaButton>
        </div>

        <button
          id="nav-toggle"
          type="button"
          class="grid h-11 w-11 place-items-center border border-ink-600 text-steel-200 lg:hidden"
          aria-expanded="false"
          aria-controls="nav-drawer"
          aria-label="Open menu"
        >
          <Icon name="menu" class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="nav-drawer"
    class="hidden border-b border-ink-700 bg-ink-950/98 backdrop-blur-md lg:hidden"
  >
    <nav aria-label="Mobile" class="shell py-6">
      <ul class="flex flex-col gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                class="block border-b border-ink-800 py-4 font-display text-xl uppercase tracking-wide text-steel-200 transition-colors hover:text-brand-400"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <CtaButton href="#buy" size="lg" class="mt-6 w-full">Buy now</CtaButton>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");

  // Solid background once the hero has scrolled past.
  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      drawer.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => {
      setOpen(drawer.classList.contains("hidden"));
    });

    // Close after tapping a link so the anchor target is actually visible.
    drawer.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
