---
/**
 * Placeholder for photography that doesn't exist yet.
 *
 * Renders a labeled slot describing the shot the client needs to supply.
 * Once a real file lands in /public/images, pass `src` and the placeholder
 * disappears, with no markup changes required.
 */
interface Props {
  /** Path under /public once the real photo exists, e.g. "/images/hero.jpg" */
  src?: string;
  alt: string;
  /** Art-direction note shown in the placeholder state. */
  note?: string;
  ratio?: string;
  class?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt,
  note,
  ratio = "4 / 3",
  class: className = "",
  loading = "lazy",
} = Astro.props;
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      loading={loading}
      decoding="async"
      class:list={["h-full w-full object-cover", className]}
      style={`aspect-ratio: ${ratio}`}
    />
  ) : (
    <div
      class:list={[
        "relative flex flex-col items-center justify-center gap-3 overflow-hidden border-2 border-dashed border-ink-600 bg-ink-850 p-6 text-center",
        className,
      ]}
      style={`aspect-ratio: ${ratio}`}
      role="img"
      aria-label={alt}
    >
      <div class="texture-topo pointer-events-none absolute inset-0 opacity-70"></div>

      <svg
        class="relative h-8 w-8 text-ink-600"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <circle cx="8.5" cy="10" r="1.5"></circle>
        <path d="m4 17 5-5 4 4 3-2 4 3"></path>
      </svg>

      <p class="relative font-display text-sm uppercase tracking-[0.2em] text-steel-500">
        Photo needed
      </p>

      <p class="relative max-w-xs text-sm leading-snug text-steel-500">
        {note ?? alt}
      </p>
    </div>
  )
}
