---
/**
 * Wordmark. The three-stroke splash echoes the mark printed on the bottle.
 * TODO(assets): swap for the client's real vector logo when supplied.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg class="h-6 w-6 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M3 15c3.5-1.8 6.2-2.4 9.5-2.2M5 19.5c3-1.5 5.3-2 8-1.9M6.5 10c3.2-2 5.8-2.8 9-2.9"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"></path>
  </svg>

  <span class="font-display text-2xl font-extrabold uppercase tracking-tight text-white">
    Squeejit
  </span>
</span>
